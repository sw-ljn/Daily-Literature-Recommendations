# Exact Google Scholar results through the managed SerpApi backend.
# Obtain the key from SerpApi and keep the real value only in .env or user configuration.
SERPAPI_API_KEY=
PAPER_SEARCH_GOOGLE_SCHOLAR_BACKEND=serpapi

# The patched arXiv source needs enough time for its 30-second provider cooldown
# plus a retry or web fallback. Values below the ordinary source timeout are ignored.
PAPER_SEARCH_ARXIV_SOURCE_TIMEOUT_MS=60000
